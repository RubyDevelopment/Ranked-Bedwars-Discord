# ── Required ────────────────────────────────────────────

# Discord bot token (Developer Portal → your application → Bot)
DISCORD_BOT_TOKEN=

# Ranked-Bedwars-Database HTTP API, reached through its SDK (used by src/database)
DATABASE_API_URL=http://127.0.0.1:8080
# Bearer key; a master key (the API's MASTER_API_KEY) lets the bot serve every guild.
DATABASE_API_KEY=

========================================
# OPTIONAL
========================================

# The bot's application id (shown in logs and used as an identifier; defaults to UNKNOWN_BOT_ID)
DISCORD_BOT_ID=

# How long one Database API call may take (Go duration). Default 15s.
DATABASE_API_TIMEOUT=15s

# Engine bridge: where Ranked-Bedwars-Engine (the Minecraft side of games) connects.
# Leave ENGINE_BRIDGE_ADDR empty to host every game by hand. The secret is required when the address is set,
# and must match the engine's ENGINE_BRIDGE_SECRET.
ENGINE_BRIDGE_ADDR=127.0.0.1:8765
ENGINE_BRIDGE_SECRET=

# Live Minecraft chat on the dashboard (Bots page). The dashboard's server calls GET /live/chat on the ENGINE_BRIDGE_ADDR port
# with this secret: set the same value as BOT_LIVE_SECRET on the dashboard (plus BOT_LIVE_URL there = where it can reach this bot).
# Chat is only sent while someone has the preview open. Leave empty to turn the feature off. Needs ENGINE_BRIDGE_ADDR.
LIVE_CHAT_SECRET=

# Vercel Blob: where finished games' Discord and Minecraft chat logs are stored (shown on the dashboard's game results).
# Use the same store token as the dashboard. Leave empty to keep no logs.
BLOB_READ_WRITE_TOKEN=
# Only to point at a different Blob API (default https://vercel.com/api/blob)
VERCEL_BLOB_API_URL=

# The dashboard's address (no trailing slash): used for the plan page links the bot posts.
DASHBOARD_URL=

# Register slash commands in this one guild instead of globally (they update instantly; handy while developing).
DEVELOPMENT_GUILD_ID=

# Local testing without plan checks (1 / true / yes)
DEV_MODE=
# off = skip plan enforcement (for rolling plans out to servers registered before they existed)
PLAN_ENFORCEMENT=
# RFC 3339 date: servers registered before it that never had a plan are exempt from plan checks. Unset = nobody.
PLAN_GRANDFATHER_BEFORE=

# debug (default), info, warn or error
LOG_LEVEL=debug
