# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_BOT_ID=

# Ranked-Bedwars-Database-Go HTTP API (used by src/database)
DATABASE_API_URL=http://127.0.0.1:8080
DATABASE_API_KEY=

# Engine bridge: where Ranked-Bedwars-Engine (the Minecraft side of games) connects.
# Leave ENGINE_BRIDGE_ADDR empty to host every game by hand.
ENGINE_BRIDGE_ADDR=127.0.0.1:8765
ENGINE_BRIDGE_SECRET=

# Vercel Blob: where finished games' Discord and Minecraft chat logs are stored (shown on the dashboard's game results).
# Use the same store token as the dashboard. Leave empty to keep no logs.
BLOB_READ_WRITE_TOKEN=

# Dev mode (see src/dev/mock.go): seeds a mock guild and players. Needs Ranked-Bedwars-Database-Go/cmd/dev-server running.
DEV_MODE=false
DEV_GUILD_ID=
DEV_USER_ID=
DEV_USERNAME=DevPlayer
