# =============================================================================
# Ranked Bedwars Discord bot
# -----------------------------------------------------------------------------
# Copy to .env. The bot loads it on start-up (real environment variables win).
# .env is gitignored. Never commit real secrets.
# =============================================================================


# =============================================================================
# REQUIRED
# =============================================================================

# --- Discord -----------------------------------------------------------------
# Developer Portal > your application > Bot
DISCORD_BOT_TOKEN=

# --- Database API ------------------------------------------------------------
# Ranked-Bedwars-Database HTTP API. A master key (the API's MASTER_API_KEY) lets
# the bot serve every server.
DATABASE_API_URL=http://127.0.0.1:25746
DATABASE_API_KEY=


# =============================================================================
# OPTIONAL
# =============================================================================

# --- General -----------------------------------------------------------------
# The bot's application id, shown in logs (defaults to UNKNOWN_BOT_ID).
DISCORD_BOT_ID=

# debug (default), info, warn or error
LOG_LEVEL=debug

# How long one Database API call may take (Go duration). Default 15s.
DATABASE_API_TIMEOUT=15s

# Register slash commands in this one server instead of globally. They update
# instantly, which is handy while developing.
DEVELOPMENT_GUILD_ID=

# The dashboard's address, no trailing slash. Used for the links the bot posts.
DASHBOARD_URL=

# --- Engine bridge -----------------------------------------------------------
# Where Ranked-Bedwars-Engine (the Minecraft side of games) connects.
# Leave ENGINE_BRIDGE_ADDR empty to host every game by hand. The secret is
# required when the address is set and must equal the Engine's ENGINE_BRIDGE_SECRET.
ENGINE_BRIDGE_ADDR=127.0.0.1:8765
ENGINE_BRIDGE_SECRET=

# --- Live chat on the dashboard (Bots page) ----------------------------------
# The dashboard's server calls GET /live/chat on the ENGINE_BRIDGE_ADDR port with
# this secret. Set the same value as BOT_LIVE_SECRET on the dashboard, plus
# BOT_LIVE_URL there pointing at this bot. Chat is only sent while someone has the
# preview open. The same secret also lets the dashboard tell the bot to apply a
# server's bot name, icon and banner the moment they are saved (POST /live/appearance);
# without it, that happens when the bot next starts. Leave empty to turn it off.
# Needs ENGINE_BRIDGE_ADDR.
LIVE_CHAT_SECRET=

# --- Game chat logs (Vercel Blob) --------------------------------------------
# Private store holding finished games' Discord and Minecraft chat, shown on game
# results. Use the same store token as the dashboard. Leave empty to keep no logs.
BLOB_READ_WRITE_TOKEN=
# Only to point at a different Blob API (default https://vercel.com/api/blob).
VERCEL_BLOB_API_URL=

# --- Plan checks -------------------------------------------------------------
# DEV_MODE: local testing without plan checks (1, true or yes).
# PLAN_ENFORCEMENT: "off" skips plan enforcement.
# PLAN_GRANDFATHER_BEFORE: RFC 3339 date. Servers registered before it that never
# had a plan are exempt from plan checks. Unset means nobody is exempt.
DEV_MODE=
PLAN_ENFORCEMENT=
PLAN_GRANDFATHER_BEFORE=


# =============================================================================
# BUILDING ON A HOST
# -----------------------------------------------------------------------------
# The Database SDK is fetched from the private GitHub repository
# (github.com/RubyDevelopment/Ranked-Bedwars-Database) when `go mod download`
# runs. Set these as the host's environment variables (for example the panel's
# Startup tab), not in this file.
#
#   GOPRIVATE=github.com/RubyDevelopment/*
#   GOSUMDB=off
#   GIT_CONFIG_COUNT=1
#   GIT_CONFIG_KEY_0=url.https://<github-token>@github.com/.insteadOf
#   GIT_CONFIG_VALUE_0=https://github.com/
#
# <github-token> is a fine-grained GitHub token with read-only "Contents" access
# to the Database repository.
# To pick up a newer Database release:
#   go get github.com/RubyDevelopment/Ranked-Bedwars-Database@vX.Y.Z
# =============================================================================
